{
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @olist-crm/web",
  "outputDirectory": "apps/web/dist",
  "headers": [
    {
      "source": "/relatorio-executivo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tarefas-api/:path*",
      "destination": "https://xp-tarefas-equipe.base-coat.chatgpt.site/api/:path*"
    },
    {
      "source": "/((?!assets/|tarefas-api/|.*\\.(?:html|png|jpg|jpeg|gif|svg|ico|js|css|json|woff2?|ttf|otf)).*)",
      "destination": "/"
    }
  ]

}
